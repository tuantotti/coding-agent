AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=2025-04-01-preview

CODING_MODEL=azure_openai:gpt-5.4-nano
CODING_WORKSPACE_ROOT=.
CODING_MAX_REMEDIATION_CYCLES=2
CODING_SHELL_TIMEOUT_SECONDS=120

# Shell example: export this for the terminal, which does not load .env itself.
# Overridden by python -m src.terminal --api-url.
CODING_AGENT_API_URL=http://127.0.0.1:8000

# =============================================================================
# Langsmith SETTINGS (optional)
# =============================================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

TAVILY_API_KEY=

# Optional Langfuse tracing; independent of LangSmith.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
